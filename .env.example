# Copy to .env.local for development, and set these in Vercel → Project
# Settings → Environment Variables for production. Never commit real values.

# The Instagram section on the homepage does NOT use the Graph API (no
# token, no login, no account risk) — it embeds public posts via
# Instagram's own embed.js widget. To feature a post, add its URL to
# src/data/instagramPosts.ts. No env var needed for this.

# Optional background video for the Hero section (looped, muted, autoplay).
# Must be a direct, public MP4 (H.264) URL. Exposed to the browser — do not
# put anything private here. If unset, the Hero falls back to its usual
# gradient background with no other changes.
NEXT_PUBLIC_HERO_VIDEO_URL=
